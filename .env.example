# OpenAI-compatible API (OpenAI / DeepSeek / 通义 / 本地 Ollama 等)
# 性价比默认：DeepSeek；也可换成 OpenAI / 通义等兼容接口
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
# 制度 LOCAL 默认 Flash；通用/联网/细想自动升到 COMPLEX
LLM_MODEL=deepseek-v4-flash
LLM_MODEL_COMPLEX=deepseek-v4-pro

# 服务
HOST=127.0.0.1
PORT=8000
# 跨域前端才填写，使用逗号分隔；默认仅允许同源请求
CORS_ORIGINS=

# 无 API Key 时自动进入 mock 模式，仍可跑通全流程
MOCK_MODE=auto

# SQLite 本地数据库（默认 data/app.db，可不填）
DATABASE_URL=

# ---------- 知识库 / RAG 资源上限（P1，默认无高占用）----------
UPLOAD_MAX_MB=20
DOC_MAX_CHARS=200000
RAG_SCAN_LIMIT=200
RAG_TOP_K_MAX=8
RAG_MAX_CHUNKS_PER_DOC=48
RAG_CHUNK_SIZE=280
RAG_CHUNK_OVERLAP=40
AGENT_MAX_STEPS=4

# ---------- 可观测与限流（P2）----------
HTTP_TIMEOUT_WEB=12
HTTP_TIMEOUT_RESEARCH=6
LLM_TIMEOUT_SECONDS=90
MAX_CONCURRENT_CHATS=20
MAX_CHATS_PER_USER=2
CHAT_QUEUE_WAIT_SECONDS=45
LLM_HTTP_MAX_CONNECTIONS=24
WEB_CIRCUIT_FAIL_THRESHOLD=2
TRACE_MAX_RECENT=40

# ---------- 可选向量检索（P3，默认关闭；关闭=TF-IDF）----------
# 开启后：embedding + data/vector_index 本地索引；失败自动回退 TF-IDF
RAG_VECTOR_ENABLED=false
# hash=本地零依赖哈希向量（默认）；fastembed=本地 BGE；openai=远程 embeddings
RAG_EMBEDDING_PROVIDER=hash
RAG_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
RAG_EMBEDDING_DIM=512
RAG_VECTOR_INDEX_DIR=data/vector_index
RAG_LEXICAL_WEIGHT=0.55
RAG_VECTOR_WEIGHT=0.45

# ---------- 可选知识图谱（P4，默认关闭；失败不影响文档 RAG）----------
# 开启后：规则抽取实体/关系写入 SQLite，search_graph 可查子图
RAG_GRAPH_ENABLED=false
RAG_GRAPH_EXTRACT_ON_LEARN=true
RAG_GRAPH_MAX_ENTITIES_PER_DOC=32
RAG_GRAPH_MAX_RELATIONS_PER_DOC=48
RAG_GRAPH_MIN_CONFIDENCE=0.5
RAG_GRAPH_HOPS=1
RAG_GRAPH_SCHEMA_VERSION=1

# ---------- 自定义回复音色（把你的声音变成助手朗读音）----------
# 本地免费克隆（已接好）：放入声音样本.m4a 或 data/voice/clone_sample.wav
# 系统会自动裁出约 10 秒清晰片段到 data/voice/clone_ref.wav
TTS_PROVIDER=auto
TTS_VOICE_SAMPLE=data/voice/clone_ref.wav
# 备选（云端）：https://elevenlabs.io Instant Voice Clone 后填写
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

# ---------- MCP（Model Context Protocol）----------
# 1) 把 Atlas 工具暴露给 Cursor：复制 mcp.cursor.example.json 到 Cursor MCP 配置
#    或运行: .\.venv\Scripts\python.exe scripts\mcp_server.py
# 2) 让 Atlas 调用外部 MCP 工具（可选）：
MCP_ENABLED=false
# JSON 数组或 Cursor 风格对象，例如：
# MCP_SERVERS=[{"name":"filesystem","command":"npx","args":["-y","@modelcontextprotocol/server-filesystem","."]}]
MCP_SERVERS=
RAG_RERANK_ENABLED=false
RAG_RERANK_CANDIDATES=12
RAG_RERANK_MODEL=deepseek-v4-pro
# 默认关闭：自动 FAQ 需要额外 LLM 调用，建议先经制度导入自测后再启用
RAG_FAQ_EXTRACT_ON_LEARN=false
# 公网口令（非空则启用登录门禁；局域网可留空）
ATLAS_PUBLIC_PASSWORD=
# 默认启用用户隔离：对话和知识库仅当前账号可见
ATLAS_USER_AUTH=true
# 非空时注册必须填写邀请码
ATLAS_REGISTER_SECRET=
